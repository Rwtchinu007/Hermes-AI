# Copy to .env and fill in. Never commit real values.

# --- Core ---
PORT=3000
MONGO_URI=
JWT_SECRET=
# Public URL of the app (used for CORS and the email verification link)
FRONTEND_URL=http://localhost:3000
# Set to "production" in deployment so the auth cookie is marked Secure
NODE_ENV=development

# --- AI ---
GEMINI_API_KEY=
MISTRAL_API_KEY=
TAVILY_API_KEY=

# --- Email (Brevo HTTPS API, used for verification emails) ---
# API key: Brevo > SMTP & API > API Keys
BREVO_API_KEY=
# Sender address verified in Brevo > Senders, Domains & Dedicated IPs
MAIL_FROM=

# --- Google Sign-In ("Continue with Google") ---
# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console.
# Add your app origins (e.g. http://localhost:3000 and your production URL)
# under "Authorized JavaScript origins". The backend verifies every Google
# ID token against this client ID.
# Leave empty to hide Google sign-in (the button shows "not configured").
GOOGLE_OAUTH_CLIENT_ID=
# Optional. With it, the login page uses a custom-styled Google button and the
# backend exchanges Google's one-time code server-side. Without it, Google's
# pre-built button is shown instead.
GOOGLE_OAUTH_CLIENT_SECRET=
